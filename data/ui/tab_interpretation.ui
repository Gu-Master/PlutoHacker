      <property name="styleSheet">
       <string notr="true">QFrame#frameSignalsSidebar {
    background: rgba(18, 24, 38, 0.94);
    border-right: 1px solid rgba(96, 165, 250, 0.20);
}
QPushButton#btnRecordSignal, QPushButton#btnOpenSignalFiles, QPushButton#btnChooseSignalFolder {
    min-height: 42px;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 600;
    padding: 8px 12px;
}
QPushButton#btnRecordSignal {
    background: rgba(230, 168, 72, 0.18);
    border: 1px solid rgba(230, 168, 72, 0.40);
}
QPushButton#btnOpenSignalFiles {
    background: rgba(96, 165, 250, 0.16);
    border: 1px solid rgba(96, 165, 250, 0.40);
}
QPushButton#btnChooseSignalFolder {
    background: rgba(74, 222, 128, 0.14);
    border: 1px solid rgba(74, 222, 128, 0.35);
}
QListWidget#listWidgetSignals {
    border: 1px solid rgba(148, 163, 184, 0.22);
    border-radius: 12px;
    padding: 6px;
    outline: none;
}
QListWidget#listWidgetSignals::item {
    min-height: 32px;
    border-radius: 8px;
    padding: 6px 8px;
}
QListWidget#listWidgetSignals::item:selected {
    background: rgba(96, 165, 250, 0.22);
}
QFrame#frameSignalMeta {
    background: rgba(30, 41, 59, 0.85);
    border: 1px solid rgba(148, 163, 184, 0.18);
    border-radius: 12px;
}
QLabel#labelSignalMetaTitle {
    font-size: 12px;
    font-weight: 700;
    color: rgba(226, 232, 240, 0.94);
}
QLabel#labelSignalMetaValue {
    font-size: 12px;
    color: rgba(226, 232, 240, 0.72);
}</string>
